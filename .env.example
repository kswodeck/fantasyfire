# Database — two ISOLATED Supabase orgs (separate billing + egress quotas):
#   • LOCAL dev + Vercel PREVIEW → the FREE "dev" org's project (this file / Vercel Preview scope)
#   • PRODUCTION (Vercel + CI)   → the PRO "prod" org's project (.env.prod.local / Vercel Production scope)
# Check which project an env points at with `pnpm db:target` (prod: `pnpm db:target:prod`) — no password printed.
DATABASE_URL=            # app/build: Supabase TRANSACTION pooler (port 6543)
DIRECT_URL=              # migrations: Supabase SESSION pooler (port 5432) or direct
# Seasons are OPTIONAL — each sport's season is computed from today's date.
# Set one only to force a specific season, e.g. backfilling: NBA_SEASON=2024-25
# NBA_SEASON=
# MLB_SEASON=
# NFL_SEASON=
# NHL_SEASON=
# WNBA_SEASON=
# MLS_SEASON=
# CFB_SEASON=
# CBB_SEASON=
# (Games below a player's normal opportunity are excluded automatically using a
# per-player threshold = avg of their season and last-10 workload. NBA = minutes;
# MLB hitters = plate appearances; MLB pitchers = every appearance; NFL = role
# involvement (QB pass attempts, RB carries+receptions). No env var to tune; bench
# players / platoon bats are not zeroed out.)

# Site URL — used for canonical tags, sitemap.xml, and OpenGraph image URLs.
# Local dev: http://localhost:3000 ; production: https://fantasyfire.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification (URL-prefix property → "HTML tag" method).
# Paste the token from the <meta name="google-site-verification" content="..."> GSC
# shows. Leave empty if you verify by DNS instead. Optional.
GOOGLE_SITE_VERIFICATION=

# IndexNow key (Bing/Yandex/DuckDuckGo instant recrawl). PUBLIC — it's served at
# /<key>.txt. A default key is baked in and the matching file is committed under
# public/, so `pnpm indexnow` works with no config. Override only to rotate the key
# (then also rename public/<key>.txt to match). Optional.
INDEXNOW_KEY=

# Social auto-publish (docs/MARKETING.md §3) — daily top-leans posts to Bluesky /
# Discord / Telegram with the branded card from /api/og/daily/[sport]. INERT until
# SOCIAL_PUBLISH_ENABLED=true; each channel is skipped unless its secrets are set;
# best-effort (a failed channel never fails the pipeline). Test with
# `pnpm social --dry-run` (prints captions, posts nothing).
SOCIAL_PUBLISH_ENABLED=
# College props are state-restricted — cfb,cbb stay out of auto-posts by default.
SOCIAL_SPORTS_EXCLUDE=cfb,cbb
# Which book's lines the posts use, mirroring the site board: first available
# source (PrizePicks-ordered) when provided lines are on; computed median lines
# otherwise. Set to pin a specific book (prizepicks | underdog | sleeper | …).
SOCIAL_LINES_SOURCE=
BLUESKY_IDENTIFIER=              # handle, e.g. fantasyfire.app
BLUESKY_APP_PASSWORD=            # an APP password (Settings → App Passwords), never the real one
DISCORD_WEBHOOK_URL=             # public #daily-leans channel webhook
DISCORD_CONTENT_PACK_WEBHOOK_URL=  # PRIVATE owner-only briefing channel webhook
TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_CHAT_ID=                # channel id ("-100…") or public @handle
# Instagram + Threads (Meta dev app in dev mode, own account as tester — no App
# Review). Long-lived tokens last 60 days; regenerate/refresh before expiry.
IG_USER_ID=                      # professional account's IG user id
IG_ACCESS_TOKEN=                 # long-lived Instagram access token
THREADS_USER_ID=                 # GET graph.threads.net/v1.0/me?fields=id
THREADS_ACCESS_TOKEN=            # long-lived Threads access token
# (The weekly.yml workflow auto-refreshes both Meta tokens in place when a
# GH_PAT secret — fine-grained PAT with Secrets read/write — exists.)

# Weekly Umami metrics digest → the private Discord content-pack channel
# (pnpm metrics, scheduled Sundays in weekly.yml). Create an API key at
# https://cloud.umami.is/settings/api. Inert until both are set.
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# Web Push (PWA lean-alert digest). Inert until BOTH keys are set — generate a pair
# with `npx web-push generate-vapid-keys`. The PUBLIC key is not secret (it ships to
# the browser); keep the PRIVATE key server-side only (a GitHub Actions / cron secret).
# `pnpm push` sends a capped digest of today's strongest leans to opted-in browsers.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@fantasyfire.app

# Real prop lines — OFF by default. When PROVIDED_LINES_ENABLED=true, the board +
# player pages PREFER the real book line (with a per-book dropdown, PrizePicks
# default) over our computed median; left off the feature is inert (no DB hit,
# no change to what's rendered).
#   1. Ingest the books (no API key needed): pnpm ingest:providedlines
#      → PrizePicks + Underdog (direct) + RotoWire's public picks aggregator, which
#        adds Sleeper, DraftKings Pick6, RT Sports + sportsbooks. UNOFFICIAL public
#        endpoints (ToS gray area), all reachable from GitHub Actions — no proxy.
#   2. Flip PROVIDED_LINES_ENABLED=true.
PROVIDED_LINES_ENABLED=false

# On-demand ISR revalidation. Pages revalidate on a long (daily) timer to keep
# Vercel ISR Writes low; when lines are enabled, the providedlines ingest pings
# POST /api/revalidate for ONLY the player/stat pages whose number actually moved,
# so those SSR snapshots stay fresh without regenerating the whole site on a clock.
# Set the SAME secret on the Vercel deployment (so the route accepts the ping) and
# in the ingest's environment (so it sends one). Unset on either side = inert; the
# client-side React Query refetch still keeps the *rendered* line live regardless.
REVALIDATE_SECRET=

# Optional / later:
BALLDONTLIE_API_KEY=     # only if used for metadata
THE_ODDS_API_KEY=        # only if you add a paid props feed later
AUTH_SECRET=             # only when Auth.js is enabled

# Cookieless analytics (Umami). The script + website id are built into the app
# (src/components/Analytics.tsx) and load automatically ONLY on the production
# deployment (off in local dev + Vercel previews so they don't pollute the stats).
# Page views are automatic; custom funnel events (stat_switched, line_entered,
# fairprice_used) also fire. Optional overrides (not normally needed):
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID   — point at a different Umami site
#   NEXT_PUBLIC_UMAMI_SRC          — self-hosted Umami script URL
# Force analytics on outside production (e.g. to verify locally):
NEXT_PUBLIC_ANALYTICS_ENABLED=false
