DATABASE_URL=            # app/build: Supabase TRANSACTION pooler (port 6543)
DIRECT_URL=              # migrations: Supabase SESSION pooler (port 5432) or direct
# NBA_SEASON is OPTIONAL — the season is computed from today's date (flips on Oct 15).
# Set it only to force a specific season, e.g. backfilling: NBA_SEASON=2024-25
# NBA_SEASON=
NBA_MIN_MINUTES=10       # exclude games below this many minutes (DNPs/garbage time) from rates & DvP

# Site URL — used for canonical tags, sitemap.xml, and OpenGraph image URLs.
# Local dev: http://localhost:3000 ; production: https://fantasyfire.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional / later:
BALLDONTLIE_API_KEY=     # only if used for metadata
THE_ODDS_API_KEY=        # only if you add a paid props feed later
AUTH_SECRET=             # only when Auth.js is enabled

# Privacy-friendly analytics (Phase 5). Off by default.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
