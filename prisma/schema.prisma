// FantasyFire Prisma schema — multi-sport (NBA + MLB).
//
// One set of tables serves both sports, discriminated by `sport` ("nba" | "mlb").
// PlayerGameStat holds a nullable superset of both sports' per-game stats; each
// row populates only its sport's columns. The pure compute layer reads them via
// a stat registry, so hit rates / confidence / charts are shared across sports.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id           Int     @id @default(autoincrement())
  sport        String // "nba" | "mlb"
  externalId   Int // league team id (NBA TEAM_ID / MLB team id)
  abbreviation String
  name         String
  conference   String?
  division     String?

  players         Player[]
  homeGames       Game[]           @relation("home")
  awayGames       Game[]           @relation("away")
  playerGameStats PlayerGameStat[] @relation("statTeam")
  opponentStats   PlayerGameStat[] @relation("statOpponent")
  scheduledHome   ScheduledGame[]  @relation("scheduledHome")
  scheduledAway   ScheduledGame[]  @relation("scheduledAway")

  @@unique([sport, externalId])
  @@unique([sport, abbreviation])
}

model Player {
  id          Int     @id @default(autoincrement())
  sport       String
  externalId  Int // PERSON_ID / MLB person id
  firstName   String
  lastName    String
  slug        String
  position    String?
  posBucket   String? // NBA: G/F/C ; MLB: H (hitter) / P (pitcher)
  jersey      String?
  height      String?
  weight      Int?
  college     String?
  country     String?
  draftYear   Int?
  draftRound  Int?
  draftNumber Int?
  fromYear    Int?
  teamId      Int?
  team        Team?   @relation(fields: [teamId], references: [id])

  gameStats           PlayerGameStat[]
  projectionSnapshots ProjectionSnapshot[]

  @@unique([sport, externalId])
  @@unique([sport, slug])
  @@index([sport, lastName])
}

model Game {
  id         Int      @id @default(autoincrement())
  sport      String
  externalId String // game id (NBA zero-padded GAME_ID / MLB gamePk)
  date       DateTime
  season     String
  homeTeamId Int
  awayTeamId Int
  homeTeam   Team     @relation("home", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("away", fields: [awayTeamId], references: [id])

  stats PlayerGameStat[]

  @@unique([sport, externalId])
  @@index([sport, date])
}

model PlayerGameStat {
  id             Int      @id @default(autoincrement())
  sport          String
  playerId       Int
  gameId         Int
  teamId         Int
  opponentTeamId Int
  isHome         Boolean
  season         String
  gameDate       DateTime
  minutes        Float? // NBA
  wl             String?
  plusMinus      Int? // NBA

  // NBA box score (nullable)
  points    Int?
  rebounds  Int?
  oreb      Int?
  dreb      Int?
  assists   Int?
  steals    Int?
  blocks    Int?
  turnovers Int?
  fouls     Int?
  fgm       Int?
  fga       Int?
  fg3m      Int?
  fg3a      Int?
  ftm       Int?
  fta       Int?

  // MLB hitting (nullable)
  atBats      Int?
  hits        Int?
  doubles     Int?
  triples     Int?
  homeRuns    Int?
  runs        Int?
  rbi         Int?
  walks       Int?
  strikeouts  Int? // batter
  stolenBases Int?
  totalBases  Int?
  hbp         Int?

  // MLB pitching (nullable)
  outs              Int? // outs recorded (IP * 3)
  hitsAllowed       Int?
  runsAllowed       Int?
  earnedRuns        Int?
  walksAllowed      Int?
  strikeoutsPitched Int?
  pitcherWin        Boolean?

  player       Player @relation(fields: [playerId], references: [id])
  game         Game   @relation(fields: [gameId], references: [id])
  team         Team   @relation("statTeam", fields: [teamId], references: [id])
  opponentTeam Team   @relation("statOpponent", fields: [opponentTeamId], references: [id])

  @@unique([playerId, gameId])
  @@index([sport, playerId, gameDate])
  @@index([sport, opponentTeamId, season])
}

// Upcoming/recent games for the "tonight" slate. Pulled on a free schedule feed
// (statsapi.mlb.com for MLB; ESPN scoreboard for NBA) — separate from the
// completed-game box scores in Game/PlayerGameStat.
model ScheduledGame {
  id                  Int      @id @default(autoincrement())
  sport               String
  externalId          String // MLB gamePk / NBA (ESPN) event id
  date                DateTime // game date (date-only, UTC midnight)
  season              String
  homeTeamId          Int
  awayTeamId          Int
  status              String?
  homeProbablePitcher String?
  awayProbablePitcher String?

  homeTeam Team @relation("scheduledHome", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("scheduledAway", fields: [awayTeamId], references: [id])

  @@unique([sport, externalId])
  @@index([sport, date])
}

// A frozen FireScore "lean" prediction, later graded against the player's next
// game — the data behind the public /accuracy calibration page. Honest backtest
// of past performance, never a pick record.
model ProjectionSnapshot {
  id            Int      @id @default(autoincrement())
  sport         String
  playerId      Int
  stat          String
  line          Float
  snapshotDate  DateTime // date the prediction was made (date-only)
  predictedSide String // 'over' | 'under'
  overHitRate   Float? // predicted over probability at snapshot
  wilsonLower   Float?
  fireScore     Int
  fireTier      String

  // Grading (filled once the target game completes):
  targetGameDate DateTime?
  actualValue    Float?
  outcome        String? // 'over' | 'under' | 'push'
  graded         Boolean   @default(false)

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, stat, snapshotDate])
  @@index([sport, graded])
}
