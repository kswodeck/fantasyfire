// FantasyFire Prisma schema — multi-sport (NBA + MLB + NFL).
//
// One set of tables serves all sports, discriminated by `sport`
// ("nba" | "mlb" | "nfl"). PlayerGameStat holds a nullable superset of every
// sport's per-game stats; each row populates only its sport's columns. The pure
// compute layer reads them via a stat registry, so hit rates / confidence /
// charts are shared across sports.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id           Int     @id @default(autoincrement())
  sport        String // "nba" | "mlb"
  externalId   Int // league team id (NBA TEAM_ID / MLB team id)
  abbreviation String
  name         String
  conference   String?
  division     String?

  players         Player[]
  homeGames       Game[]           @relation("home")
  awayGames       Game[]           @relation("away")
  playerGameStats PlayerGameStat[] @relation("statTeam")
  opponentStats   PlayerGameStat[] @relation("statOpponent")
  scheduledHome   ScheduledGame[]  @relation("scheduledHome")
  scheduledAway   ScheduledGame[]  @relation("scheduledAway")

  @@unique([sport, externalId])
  @@unique([sport, abbreviation])
}

model Player {
  id          Int     @id @default(autoincrement())
  sport       String
  externalId  Int // PERSON_ID / MLB person id
  firstName   String
  lastName    String
  slug        String
  position    String?
  posBucket   String? // NBA: G/F/C ; MLB: H (hitter) / P (pitcher) ; NFL: QB/RB/WR/TE
  jersey      String?
  height      String?
  weight      Int?
  college     String?
  country     String?
  draftYear   Int?
  draftRound  Int?
  draftNumber Int?
  fromYear    Int?
  teamId      Int?
  team        Team?   @relation(fields: [teamId], references: [id])

  gameStats     PlayerGameStat[]
  providedLines ProvidedLine[]

  @@unique([sport, externalId])
  @@unique([sport, slug])
  @@index([sport, lastName])
}

model Game {
  id         Int      @id @default(autoincrement())
  sport      String
  externalId String // game id (NBA zero-padded GAME_ID / MLB gamePk)
  date       DateTime
  season     String
  homeTeamId Int
  awayTeamId Int
  homeTeam   Team     @relation("home", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("away", fields: [awayTeamId], references: [id])

  stats PlayerGameStat[]

  @@unique([sport, externalId])
  @@index([sport, date])
}

model PlayerGameStat {
  id             Int      @id @default(autoincrement())
  sport          String
  playerId       Int
  gameId         Int
  teamId         Int
  opponentTeamId Int
  isHome         Boolean
  season         String
  gameDate       DateTime
  minutes        Float? // NBA
  wl             String?
  plusMinus      Int? // NBA

  // NBA box score (nullable)
  points    Int?
  rebounds  Int?
  oreb      Int?
  dreb      Int?
  assists   Int?
  steals    Int?
  blocks    Int?
  turnovers Int?
  fouls     Int?
  fgm       Int?
  fga       Int?
  fg3m      Int?
  fg3a      Int?
  ftm       Int?
  fta       Int?

  // MLB hitting (nullable)
  atBats      Int?
  hits        Int?
  doubles     Int?
  triples     Int?
  homeRuns    Int?
  runs        Int?
  rbi         Int?
  walks       Int?
  strikeouts  Int? // batter
  stolenBases Int?
  totalBases  Int?
  hbp         Int?

  // MLB pitching (nullable)
  outs              Int? // outs recorded (IP * 3)
  hitsAllowed       Int?
  runsAllowed       Int?
  earnedRuns        Int?
  walksAllowed      Int?
  strikeoutsPitched Int?
  pitcherWin        Boolean?

  // NFL (nullable) — one row per athlete-game, merged across ESPN stat groups
  passYards       Int?
  passTds         Int?
  passCompletions Int?
  passAttempts    Int?
  passInts        Int?
  rushYards       Int?
  rushAttempts    Int?
  rushTds         Int?
  receptions      Int?
  targets         Int?
  recYards        Int?
  recTds          Int?
  fumblesLost     Int?

  player       Player @relation(fields: [playerId], references: [id])
  game         Game   @relation(fields: [gameId], references: [id])
  team         Team   @relation("statTeam", fields: [teamId], references: [id])
  opponentTeam Team   @relation("statOpponent", fields: [opponentTeamId], references: [id])

  @@unique([playerId, gameId])
  @@index([sport, playerId, gameDate])
  @@index([sport, opponentTeamId, season])
}

// Upcoming/recent games for the "tonight" slate. Pulled on a free schedule feed
// (statsapi.mlb.com for MLB; ESPN scoreboard for NBA) — separate from the
// completed-game box scores in Game/PlayerGameStat.
model ScheduledGame {
  id                  Int      @id @default(autoincrement())
  sport               String
  externalId          String // MLB gamePk / NBA (ESPN) event id
  date                DateTime // game date (date-only, UTC midnight) — slate windowing key
  startTime           DateTime? // exact first-pitch / kickoff (UTC); null if feed omits it
  season              String
  homeTeamId          Int
  awayTeamId          Int
  status              String?
  homeProbablePitcher String?
  awayProbablePitcher String?

  homeTeam Team @relation("scheduledHome", fields: [homeTeamId], references: [id])
  awayTeam Team @relation("scheduledAway", fields: [awayTeamId], references: [id])

  @@unique([sport, externalId])
  @@index([sport, date])
}

// OPTIONAL real prop lines scraped from public DFS/sportsbook feeds,
// so the app can show the number a user actually sees on PrizePicks / Underdog /
// DK Pick6 / Sleeper instead of our derived median line. Additive and OFF by
// default (gated by PROVIDED_LINES_ENABLED) — when empty or disabled, every
// surface falls back to the computed default line, so nothing changes.
//
// One row per (sport, player, stat, source, day). Keyed by `source` so multiple
// books can coexist, and by `gameDate` so lines are preserved as history rather
// than overwritten. Populated by src/ingest/run-ingest-providedlines.ts.
model ProvidedLine {
  id        Int      @id @default(autoincrement())
  sport     String // "nba" | "mlb" | "nfl"
  playerId  Int
  stat      String // internal StatKey, e.g. "pts" | "passYds"
  source    String // bookmakerID: "prizepicks" | "underdog" | "draftkings" | "sleeper" | ...
  line      Float
  overOdds  Int? // American odds for the over, when the source posts them (DFS pick'em are fixed-payout → usually null)
  underOdds Int?
  gameDate  DateTime // the slate/game day this line applies to (date-only, UTC midnight)
  fetchedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([sport, playerId, stat, source, gameDate])
  @@index([sport, gameDate])
  @@index([playerId, stat])
}

// A browser Web Push subscription. The subscription endpoint IS the identity —
// no account, honoring the no-auth design. Captured after a high-intent moment
// (saving players) and used by run-push.ts to send a capped, value-first digest.
model PushSubscription {
  id         Int       @id @default(autoincrement())
  endpoint   String    @unique
  p256dh     String // client public key (for encryption)
  auth       String // client auth secret
  createdAt  DateTime  @default(now())
  lastSentAt DateTime? // frequency cap: don't exceed N sends/week per sub
  // Comma-separated sports the user follows (from their favorites at opt-in), so
  // the digest can be relevant; null = all sports.
  sports     String?

  @@index([lastSentAt])
}

// Audit row written by each nightly data job (one per run) — the data behind the
// public /status freshness page. Separate from the data tables so "did the job
// run and succeed?" is answerable even when a job wrote zero rows.
model IngestRun {
  id          Int      @id @default(autoincrement())
  job         String // "nba" | "mlb" | "nfl" | "schedule" | "providedlines" | "indexnow"
  status      String // "success" | "failure"
  startedAt   DateTime
  finishedAt  DateTime
  durationMs  Int
  rowsWritten Int?
  error       String?

  @@index([job, startedAt])
}
